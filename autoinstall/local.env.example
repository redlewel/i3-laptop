# Copy to autoinstall/local.env (gitignored) and edit. Read by scripts/render-autoinstall.sh.
HOSTNAME=my-laptop
USERNAME=me
REALNAME="My Name"
TIMEZONE=America/Chicago
LOCALE=en_US.UTF-8
KEYBOARD=us
DISK=/dev/nvme0n1
# Temporary credentials, rotated at first login (see user-data.tmpl header).
PASSWORD=machine-changeme
ZFS_PASSPHRASE=machine-changeme
# One or more public key files, space separated. Their contents become the
# installed user's ~/.ssh/authorized_keys.
AUTHORIZED_KEY_FILES="$HOME/.ssh/id_ed25519.pub"
